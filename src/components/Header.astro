// No changes in the script section
---

<header>
  <nav class="container">
    <a href="/" class="logo">
      <img src="/images/ivanya-logo.jpg" alt="Ivanya Logo">
    </a>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </div>
  </nav>
</header>

<style>
  header { border-bottom: 1px solid #0000001a; background-color: #fcf9f7c4; backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 10; }
  .container { display: flex; justify-content: space-between; align-items: center; padding: 15px 0; }
  .logo img { height: 45px; width: auto; display: block; }
  .nav-links a { margin-left: 25px; font-size: 1rem; transition: color 0.2s ease; }
  .nav-links a:hover { color: var(--color-accent); }
</style>