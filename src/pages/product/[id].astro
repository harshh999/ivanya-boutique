---
// --- SCRIPT SECTION ---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';

// THIS IS THE NEW FUNCTION WE ARE ADDING
// It tells Astro which pages to build for production
export function getStaticPaths() {
  return products.map(product => ({
    params: { id: product.id }
  }));
}

// Get the unique 'id' from the page's URL
const { id } = Astro.params;

// Find the product in our data array that matches this id
const product = products.find(p => p.id === id);

if (!product) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const instagramLink = `https://ig.me/m/ivanya.in`;
---

<BaseLayout>
  <div class="container">
    <div class="product-detail-layout">
      <div class="product-image-wrapper">
        <img src={product.image} alt={product.name} />
      </div>
      <div class="product-info">
        <h1>{product.name}</h1>
        <p class="price">{product.price}</p>
        <div class="description">
          <p>
            Indulge in the timeless elegance of this handcrafted piece from Ivanya. Made with the finest materials, this outfit is designed for both comfort and style, perfect for any special occasion.
          </p>
          <p>
            Fabric: Premium Cotton Blend <br>
            Care: Hand wash cold, hang to dry.
          </p>
        </div>
        <a href={instagramLink} class="buy-button" target="_blank">Buy Now (DM on Instagram)</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Styles are unchanged */
  .product-detail-layout{display:grid;grid-template-columns:1fr;gap:40px;margin-top:40px}.product-image-wrapper img{width:100%;border-radius:8px;box-shadow:0 4px 15px rgba(0,0,0,.1)}.product-info h1{font-size:2.5rem;margin-bottom:10px}.product-info .price{font-size:1.5rem;font-weight:500;color:var(--color-accent);margin-bottom:20px}.product-info .description{font-size:1.1rem;line-height:1.7;margin-bottom:30px}.buy-button{display:inline-block;background-color:var(--color-primary);color:var(--color-white);padding:15px 35px;border-radius:8px;font-size:1.2rem;font-weight:500;text-align:center;transition:transform .2s ease,box-shadow .2s ease}.buy-button:hover{transform:scale(1.05);box-shadow:0 4px 20px #0000002a}@media (min-width:768px){.product-detail-layout{grid-template-columns:1fr 1fr;align-items:flex-start}.product-info h1{font-size:3rem}}
</style>